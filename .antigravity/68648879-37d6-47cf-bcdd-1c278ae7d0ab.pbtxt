  file_change {
    absolute_path_uri: "file:///src/components/PromptInput.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Send, Zap, Flame, ShieldAlert, Sparkles, BookOpen, Compass, Code2 } from \'lucide-react\';\nimport { DebateIntensity, DebateMode } from \'../types\';\nimport { PRESET_PROMPTS, PresetPrompt } from \'../data/presetPrompts\';\n\ninterface PromptInputProps {\n  onSubmit: (prompt: string, mode: DebateMode, intensity: DebateIntensity) => void;\n  isLoading: boolean;\n}\n\nexport const PromptInput: React.FC<PromptInputProps> = ({ onSubmit, isLoading }) => {\n  const [input, setInput] = useState(\'\');\n  const [mode, setMode] = useState<DebateMode>(\'balanced\');\n  const [intensity, setIntensity] = useState<DebateIntensity>(\'deep\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!input.trim() || isLoading) return;\n    onSubmit(input.trim(), mode, intensity);\n  };\n\n  const handleSelectPreset = (preset: PresetPrompt) => {\n    setInput(preset.prompt);\n    setMode(preset.mode);\n  };\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-4 lg:p-6 shadow-xl mb-8\">\n      <form onSubmit={handleSubmit} className=\"space-y-4\">\n        {/* Main Search Input Bar */}\n        <div className=\"relative\">\n          <textarea\n            value={input}\n            onChange={(e) => setInput(e.target.value)}\n            placeholder=\"Enter any complex question, architectural debate, or strategic query for the AI models to debate...\"\n            rows={3}\n            disabled={isLoading}\n            className=\"w-full bg-slate-950 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3.5 pr-28 text-sm sm:text-base border border-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all resize-none disabled:opacity-50\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!input.trim() || isLoading}\n            className=\"absolute right-3 bottom-3.5 px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 disabled:opacity-40 text-white rounded-lg font-medium text-xs sm:text-sm flex items-center gap-2 shadow-lg shadow-indigo-600/30 transition-all cursor-pointer disabled:cursor-not-allowed\"\n          >\n            {isLoading ? (\n              <div className=\"w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n            ) : (\n              <Send className=\"w-4 h-4\" />\n            )}\n            <span>Debate</span>\n          </button>\n        </div>\n\n        {/* Mode & Intensity Selectors */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2 border-t border-slate-800/80\">\n          {/* Debate Mode Options */}\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <span className=\"text-xs font-semibold text-slate-400 mr-1\">Focus Mode:</span>\n\n            <button\n              type=\"button\"\n              onClick={() => setMode(\'balanced\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                mode === \'balanced\'\n                  ? \'bg-indigo-600/20 text-indigo-300 border border-indigo-500/50 shadow-sm\'\n                  : \'bg-slate-800/60 text-slate-400 hover:text-slate-200 border border-transparent\'\n              }`}\n            >\n              <Compass className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>Balanced</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setMode(\'technical\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                mode === \'technical\'\n                  ? \'bg-cyan-600/20 text-cyan-300 border border-cyan-500/50 shadow-sm\'\n                  : \'bg-slate-800/60 text-slate-400 hover:text-slate-200 border border-transparent\'\n              }`}\n            >\n              <Code2 className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span>Deep Technical</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setMode(\'factcheck\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                mode === \'factcheck\'\n                  ? \'bg-emerald-600/20 text-emerald-300 border border-emerald-500/50 shadow-sm\'\n                  : \'bg-slate-800/60 text-slate-400 hover:text-slate-200 border border-transparent\'\n              }`}\n            >\n              <BookOpen className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Fact Check</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setMode(\'creative\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                mode === \'creative\'\n                  ? \'bg-purple-600/20 text-purple-300 border border-purple-500/50 shadow-sm\'\n                  : \'bg-slate-800/60 text-slate-400 hover:text-slate-200 border border-transparent\'\n              }`}\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n              <span>Creative Strategy</span>\n            </button>\n          </div>\n\n          {/* Debate Intensity Toggle */}\n          <div className=\"flex items-center gap-2 bg-slate-950 p-1 rounded-xl border border-slate-800 self-end sm:self-auto\">\n            <button\n              type=\"button\"\n              onClick={() => setIntensity(\'fast\')}\n              className={`px-3 py-1 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                intensity === \'fast\'\n                  ? \'bg-slate-800 text-amber-300 font-semibold shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Zap className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>Fast (1-Round)</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setIntensity(\'deep\')}\n              className={`px-3 py-1 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                intensity === \'deep\'\n                  ? \'bg-indigo-600 text-white font-semibold shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Flame className=\"w-3.5 h-3.5 text-red-400\" />\n              <span>Deep (2-Round Debate)</span>\n            </button>\n          </div>\n        </div>\n      </form>\n\n      {/* Quick Preset Prompts */}\n      <div className=\"mt-4 pt-3 border-t border-slate-800/60\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <span className=\"text-xs font-medium text-slate-400\">Try Preset Debates:</span>\n        </div>\n        <div className=\"flex flex-wrap gap-2\">\n          {PRESET_PROMPTS.map((preset) => (\n            <button\n              key={preset.id}\n              type=\"button\"\n              onClick={() => handleSelectPreset(preset)}\n              disabled={isLoading}\n              className=\"text-xs bg-slate-950 hover:bg-slate-800 text-slate-300 hover:text-white px-3 py-1.5 rounded-lg border border-slate-800/80 hover:border-slate-700 transition-all flex items-center gap-1.5 text-left disabled:opacity-50\"\n            >\n              <span>{preset.icon}</span>\n              <span className=\"font-medium\">{preset.title}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
