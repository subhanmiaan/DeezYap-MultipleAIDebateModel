    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Cpu, MessageSquare, Scale, CheckCircle2, Loader2, Sparkles } from \'lucide-react\';\nimport { ProgressState, AgentId } from \'../types\';\nimport { AGENTS } from \'../data/agents\';\n\ninterface ProgressStepperProps {\n  progress: ProgressState;\n}\n\nexport const ProgressStepper: React.FC<ProgressStepperProps> = ({ progress }) => {\n  const { currentStep, statusText, activeAgents } = progress;\n\n  const steps = [\n    {\n      id: 1,\n      title: \'Phase 1: Querying Models\',\n      subtitle: \'Parallel draft generation across 4 LLMs\',\n      icon: Cpu,\n    },\n    {\n      id: 2,\n      title: \'Phase 2: Agents Debating & Critiquing\',\n      subtitle: \'Cross-auditing logical flaws & updating positions\',\n      icon: MessageSquare,\n    },\n    {\n      id: 3,\n      title: \'Phase 3: Synthesizing Verdict\',\n      subtitle: \'Generating ultimate consensus master answer\',\n      icon: Scale,\n    },\n  ];\n\n  return (\n    <div className=\"bg-slate-900/90 border border-indigo-500/30 rounded-2xl p-5 lg:p-6 mb-8 shadow-2xl relative overflow-hidden\">\n      {/* Background Accent Glow */}\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl -z-10 pointer-events-none\" />\n\n      <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-slate-800\">\n        <div className=\"flex items-center gap-2\">\n          <Sparkles className=\"w-5 h-5 text-indigo-400 animate-pulse\" />\n          <h3 className=\"text-base font-semibold text-white\">Debate Orchestration Engine in Progress</h3>\n        </div>\n        <span className=\"text-xs px-2.5 py-1 bg-indigo-500/20 text-indigo-300 rounded-full border border-indigo-500/30 font-medium animate-pulse\">\n          Live Execution\n        </span>\n      </div>\n\n      {/* Stepper Pipeline */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-6\">\n        {steps.map((step) => {\n          const StepIcon = step.icon;\n          const isCompleted = currentStep > step.id;\n          const isCurrent = currentStep === step.id;\n\n          return (\n            <div\n              key={step.id}\n              className={`p-3.5 rounded-xl border transition-all ${\n                isCurrent\n                  ? \'bg-indigo-950/40 border-indigo-500/60 shadow-lg shadow-indigo-500/10\'\n                  : isCompleted\n                  ? \'bg-slate-950/60 border-emerald-500/30 text-slate-300\'\n                  : \'bg-slate-950/30 border-slate-800/60 text-slate-500\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <div\n                  className={`w-9 h-9 rounded-lg flex items-center justify-center font-bold text-sm ${\n                    isCurrent\n                      ? \'bg-indigo-600 text-white shadow-md shadow-indigo-600/30\'\n                      : isCompleted\n                      ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40\'\n                      : \'bg-slate-800 text-slate-500\'\n                  }`}\n                >\n                  {isCompleted ? (\n                    <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n                  ) : isCurrent ? (\n                    <Loader2 className=\"w-5 h-5 animate-spin\" />\n                  ) : (\n                    <span>{step.id}</span>\n                  )}\n                </div>\n                <div>\n                  <h4 className={`text-xs sm:text-sm font-semibold ${isCurrent ? \'text-indigo-200\' : \'text-slate-300\'}`}>\n                    {step.title}\n                  </h4>\n                  <p className=\"text-[11px] text-slate-400 leading-tight mt-0.5\">{step.subtitle}</p>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Active Agents Badge Glow */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-3 border-t border-slate-800\">\n        <div className=\"text-xs text-slate-300 font-medium flex items-center gap-2\">\n          <Loader2 className=\"w-3.5 h-3.5 text-indigo-400 animate-spin\" />\n          <span>{statusText || \'Orchestrating multi-agent pipeline...\'}</span>\n        </div>\n\n        {/* Participating AI Agents */}\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-[11px] text-slate-400 font-medium\">Agents:</span>\n          <div className=\"flex items-center gap-1.5\">\n            {Object.values(AGENTS).map((agent) => {\n              const isActive = activeAgents.includes(agent.id as AgentId);\n              return (\n                <div\n                  key={agent.id}\n                  className={`flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium border transition-all ${\n                    isActive\n                      ? `${agent.bgColor} ${agent.textColor} ${agent.borderColor} animate-pulse`\n                      : \'bg-slate-950 text-slate-500 border-slate-800 opacity-50\'\n                  }`}\n                >\n                  <span>{agent.avatar}</span>\n                  <span className=\"text-[10px] hidden lg:inline\">{agent.badge}</span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Cpu, MessageSquare, Scale, CheckCircle2, Loader2, Sparkles } from \'lucide-react\';\nimport { ProgressState, AgentId } from \'../types\';\nimport { AGENTS } from \'../data/agents\';\n\ninterface ProgressStepperProps {\n  progress: ProgressState;\n}\n\nexport const ProgressStepper: React.FC<ProgressStepperProps> = ({ progress }) => {\n  const { currentStep, statusText, activeAgents } = progress;\n\n  const steps = [\n    {\n      id: 1,\n      title: \'Phase 1: Querying Models\',\n      subtitle: \'Parallel draft generation across 4 LLMs\',\n      icon: Cpu,\n    },\n    {\n      id: 2,\n      title: \'Phase 2: Agents Debating & Critiquing\',\n      subtitle: \'Cross-auditing logical flaws & updating positions\',\n      icon: MessageSquare,\n    },\n    {\n      id: 3,\n      title: \'Phase 3: Synthesizing Verdict\',\n      subtitle: \'Generating ultimate consensus master answer\',\n      icon: Scale,\n    },\n  ];\n\n  return (\n    <div className=\"bg-zinc-950 border border-yellow-400/40 rounded-2xl p-5 lg:p-6 mb-8 shadow-2xl relative overflow-hidden\">\n      {/* Background Accent Glow */}\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-yellow-400/5 rounded-full blur-3xl -z-10 pointer-events-none\" />\n\n      <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-zinc-800\">\n        <div className=\"flex items-center gap-2\">\n          <Sparkles className=\"w-5 h-5 text-yellow-400 animate-pulse\" />\n          <h3 className=\"text-base font-black text-white uppercase tracking-wider\">Debate Engine In Progress</h3>\n        </div>\n        <span className=\"text-xs px-2.5 py-1 bg-yellow-400 text-black rounded-full font-black uppercase text-[10px] tracking-wider animate-pulse\">\n          Live Execution\n        </span>\n      </div>\n\n      {/* Stepper Pipeline */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-6\">\n        {steps.map((step) => {\n          const isCompleted = currentStep > step.id;\n          const isCurrent = currentStep === step.id;\n\n          return (\n            <div\n              key={step.id}\n              className={`p-3.5 rounded-xl border transition-all ${\n                isCurrent\n                  ? \'bg-black border-yellow-400 shadow-lg shadow-yellow-400/10\'\n                  : isCompleted\n                  ? \'bg-black border-zinc-700 text-zinc-300\'\n                  : \'bg-black/50 border-zinc-900 text-zinc-600\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <div\n                  className={`w-9 h-9 rounded-lg flex items-center justify-center font-black text-sm ${\n                    isCurrent\n                      ? \'bg-yellow-400 text-black shadow-md shadow-yellow-400/20\'\n                      : isCompleted\n                      ? \'bg-zinc-800 text-yellow-400 border border-zinc-700\'\n                      : \'bg-zinc-900 text-zinc-600\'\n                  }`}\n                >\n                  {isCompleted ? (\n                    <CheckCircle2 className=\"w-5 h-5 text-yellow-400\" />\n                  ) : isCurrent ? (\n                    <Loader2 className=\"w-5 h-5 animate-spin\" />\n                  ) : (\n                    <span>{step.id}</span>\n                  )}\n                </div>\n                <div>\n                  <h4 className={`text-xs sm:text-sm font-bold ${isCurrent ? \'text-yellow-400\' : \'text-zinc-200\'}`}>\n                    {step.title}\n                  </h4>\n                  <p className=\"text-[11px] text-zinc-400 leading-tight mt-0.5\">{step.subtitle}</p>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Active Agents Badge Glow */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-3 border-t border-zinc-900\">\n        <div className=\"text-xs text-zinc-300 font-semibold flex items-center gap-2\">\n          <Loader2 className=\"w-3.5 h-3.5 text-yellow-400 animate-spin\" />\n          <span>{statusText || \'Orchestrating multi-agent pipeline...\'}</span>\n        </div>\n\n        {/* Participating AI Agents */}\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-[11px] text-zinc-500 font-bold uppercase tracking-wider\">Agents:</span>\n          <div className=\"flex items-center gap-1.5\">\n            {Object.values(AGENTS).map((agent) => {\n              const isActive = activeAgents.includes(agent.id as AgentId);\n              return (\n                <div\n                  key={agent.id}\n                  className={`flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-bold border transition-all ${\n                    isActive\n                      ? \'bg-yellow-400/20 text-yellow-300 border-yellow-400/50 animate-pulse\'\n                      : \'bg-black text-zinc-600 border-zinc-900 opacity-40\'\n                  }`}\n                >\n                  <span>{agent.avatar}</span>\n                  <span className=\"text-[10px] hidden lg:inline\">{agent.badge}</span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
