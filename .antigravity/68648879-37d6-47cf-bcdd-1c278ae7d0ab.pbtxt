    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { ConsensusResult } from \'../types\';\nimport { History, Trash2, Search, X, ChevronRight, Download, Clock } from \'lucide-react\';\n\ninterface HistorySidebarProps {\n  isOpen: boolean;\n  onClose: () => void;\n  history: ConsensusResult[];\n  onSelectDebate: (debate: ConsensusResult) => void;\n  onClearHistory: () => void;\n  onDeleteDebate: (id: string) => void;\n}\n\nexport const HistorySidebar: React.FC<HistorySidebarProps> = ({\n  isOpen,\n  onClose,\n  history,\n  onSelectDebate,\n  onClearHistory,\n  onDeleteDebate,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const filteredHistory = history.filter((item) =>\n    item.prompt.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex justify-end bg-slate-950/80 backdrop-blur-sm transition-all\">\n      <div className=\"w-full max-w-md bg-slate-900 border-l border-slate-800 text-slate-100 h-full flex flex-col justify-between shadow-2xl\">\n        {/* Top Header */}\n        <div className=\"p-5 border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-purple-400\" />\n            <h3 className=\"font-bold text-base text-white\">Debate History</h3>\n            <span className=\"text-xs px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-medium\">\n              {history.length}\n            </span>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Search Bar */}\n        <div className=\"p-4 border-b border-slate-800\">\n          <div className=\"relative\">\n            <Search className=\"w-4 h-4 text-slate-500 absolute left-3 top-3\" />\n            <input\n              type=\"text\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search previous debates...\"\n              className=\"w-full bg-slate-950 text-xs text-slate-100 placeholder-slate-500 rounded-lg pl-9 pr-3 py-2 border border-slate-800 focus:outline-none focus:border-indigo-500\"\n            />\n          </div>\n        </div>\n\n        {/* List of Debates */}\n        <div className=\"p-4 flex-1 overflow-y-auto space-y-3\">\n          {filteredHistory.length === 0 ? (\n            <div className=\"text-center py-12 text-slate-500 text-xs\">\n              No saved debates found. Run a debate to store results!\n            </div>\n          ) : (\n            filteredHistory.map((item) => (\n              <div\n                key={item.id}\n                className=\"bg-slate-950 hover:bg-slate-800/80 p-3.5 rounded-xl border border-slate-800 transition-all group flex flex-col justify-between gap-2\"\n              >\n                <div\n                  onClick={() => {\n                    onSelectDebate(item);\n                    onClose();\n                  }}\n                  className=\"cursor-pointer\"\n                >\n                  <p className=\"text-xs font-semibold text-slate-200 line-clamp-2 group-hover:text-indigo-300 transition-colors\">\n                    {item.prompt}\n                  </p>\n                  <div className=\"flex items-center gap-2 mt-2 text-[11px] text-slate-500\">\n                    <span className=\"flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3 text-indigo-400\" />\n                      {new Date(item.timestamp).toLocaleDateString()}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-indigo-400 font-medium\">\n                      {item.confidenceScore}% Consensus\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-slate-900\">\n                  <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-900 text-slate-400 uppercase tracking-wider font-mono\">\n                    {item.mode}\n                  </span>\n\n                  <button\n                    onClick={() => onDeleteDebate(item.id)}\n                    className=\"text-slate-600 hover:text-red-400 p-1 transition-colors\"\n                    title=\"Delete item\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Footer Actions */}\n        {history.length > 0 && (\n          <div className=\"p-4 border-t border-slate-800 flex items-center justify-between\">\n            <button\n              onClick={onClearHistory}\n              className=\"text-xs text-red-400 hover:text-red-300 flex items-center gap-1 font-medium transition-colors\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n              <span>Clear All History</span>\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { ConsensusResult } from \'../types\';\nimport { History, Trash2, Search, X, Clock } from \'lucide-react\';\n\ninterface HistorySidebarProps {\n  isOpen: boolean;\n  onClose: () => void;\n  history: ConsensusResult[];\n  onSelectDebate: (debate: ConsensusResult) => void;\n  onClearHistory: () => void;\n  onDeleteDebate: (id: string) => void;\n}\n\nexport const HistorySidebar: React.FC<HistorySidebarProps> = ({\n  isOpen,\n  onClose,\n  history,\n  onSelectDebate,\n  onClearHistory,\n  onDeleteDebate,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const filteredHistory = history.filter((item) =>\n    item.prompt.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex justify-end bg-black/80 backdrop-blur-sm transition-all\">\n      <div className=\"w-full max-w-md bg-zinc-950 border-l border-zinc-800 text-zinc-100 h-full flex flex-col justify-between shadow-2xl\">\n        {/* Top Header */}\n        <div className=\"p-5 border-b border-zinc-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-yellow-400\" />\n            <h3 className=\"font-black text-base text-white uppercase tracking-wider\">Debate History</h3>\n            <span className=\"text-xs px-2 py-0.5 rounded-full bg-yellow-400 text-black font-black\">\n              {history.length}\n            </span>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Search Bar */}\n        <div className=\"p-4 border-b border-zinc-900\">\n          <div className=\"relative\">\n            <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-3\" />\n            <input\n              type=\"text\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search previous debates...\"\n              className=\"w-full bg-black text-xs text-zinc-100 placeholder-zinc-500 rounded-lg pl-9 pr-3 py-2 border border-zinc-800 focus:outline-none focus:border-yellow-400 font-sans\"\n            />\n          </div>\n        </div>\n\n        {/* List of Debates */}\n        <div className=\"p-4 flex-1 overflow-y-auto space-y-3\">\n          {filteredHistory.length === 0 ? (\n            <div className=\"text-center py-12 text-zinc-600 text-xs font-semibold\">\n              No saved debates found. Run a debate to store results!\n            </div>\n          ) : (\n            filteredHistory.map((item) => (\n              <div\n                key={item.id}\n                className=\"bg-black hover:bg-zinc-900 p-3.5 rounded-xl border border-zinc-800 hover:border-yellow-400/50 transition-all group flex flex-col justify-between gap-2\"\n              >\n                <div\n                  onClick={() => {\n                    onSelectDebate(item);\n                    onClose();\n                  }}\n                  className=\"cursor-pointer\"\n                >\n                  <p className=\"text-xs font-bold text-zinc-200 line-clamp-2 group-hover:text-yellow-400 transition-colors\">\n                    {item.prompt}\n                  </p>\n                  <div className=\"flex items-center gap-2 mt-2 text-[11px] text-zinc-500\">\n                    <span className=\"flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3 text-yellow-400\" />\n                      {new Date(item.timestamp).toLocaleDateString()}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-yellow-400 font-black\">\n                      {item.confidenceScore}% Consensus\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-zinc-900\">\n                  <span className=\"text-[10px] px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 uppercase tracking-wider font-mono\">\n                    {item.mode}\n                  </span>\n\n                  <button\n                    onClick={() => onDeleteDebate(item.id)}\n                    className=\"text-zinc-600 hover:text-red-400 p-1 transition-colors cursor-pointer\"\n                    title=\"Delete item\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Footer Actions */}\n        {history.length > 0 && (\n          <div className=\"p-4 border-t border-zinc-900 flex items-center justify-between\">\n            <button\n              onClick={onClearHistory}\n              className=\"text-xs text-red-400 hover:text-red-300 flex items-center gap-1 font-bold transition-colors cursor-pointer\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n              <span>Clear All History</span>\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
