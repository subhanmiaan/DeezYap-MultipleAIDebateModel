    instruction: "Update ArchitectureModal component to modern minimal yellow and black theme"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { X, Cpu, ShieldCheck, Zap, Layers, FileCode } from \'lucide-react\';\nimport { ARCHITECTURE_BLUEPRINT_MARKDOWN } from \'../data/architectureBlueprint\';\n\ninterface ArchitectureModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const ArchitectureModal: React.FC<ArchitectureModalProps> = ({ isOpen, onClose }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md overflow-y-auto\">\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl max-w-3xl w-full max-h-[85vh] flex flex-col shadow-2xl my-8\">\n        {/* Header */}\n        <div className=\"p-5 border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-2 bg-indigo-500/20 rounded-xl border border-indigo-500/30 text-indigo-400\">\n              <FileCode className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-lg text-white\">System Architecture Blueprint</h3>\n              <p className=\"text-xs text-slate-400\">\n                100% Free Tier ($0 Budget) Multi-Agent AI Orchestration Architecture\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-6 text-slate-200 text-sm leading-relaxed\">\n          {/* Tech Stack Pills */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-semibold\">Frontend</span>\n              <p className=\"text-xs font-bold text-white mt-0.5\">React 19 + Vite</p>\n            </div>\n            <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-semibold\">Backend</span>\n              <p className=\"text-xs font-bold text-white mt-0.5\">Express + Node.js</p>\n            </div>\n            <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-semibold\">AI Models</span>\n              <p className=\"text-xs font-bold text-indigo-400 mt-0.5\">Gemini 3.6 Flash</p>\n            </div>\n            <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-semibold\">Search Engine</span>\n              <p className=\"text-xs font-bold text-cyan-400 mt-0.5\">Google Search Grounding</p>\n            </div>\n          </div>\n\n          {/* ASCII Blueprint Diagram */}\n          <div>\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-indigo-400 mb-2\">\n              3-Step Orchestration Pipeline\n            </h4>\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 font-mono text-[11px] sm:text-xs text-indigo-300 overflow-x-auto leading-normal whitespace-pre\">\n{`USER QUERY \342\224\200\342\224\200\342\226\272 [ Express Orchestrator ]\n                     \342\224\202\n     \342\224\214\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\274\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\254\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\220\n     \342\226\274               \342\226\274               \342\226\274               \342\226\274\n[ ChatGPT ]     [ Claude ]       [ Groq ]      [ Perplexity ]\n  (Pragmatic)     (Nuanced)       (Direct)      (Real-time Web)\n     \342\224\202               \342\224\202               \342\224\202               \342\224\202\n     \342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\274\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\264\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230\n                     \342\226\274\n          [ Step 1: Draft Phase ] (~200 token cap)\n                     \342\224\202\n                     \342\226\274\n        [ Step 2: Cross-Critique Phase ] (Audit flaws & revise)\n                     \342\224\202\n                     \342\226\274\n        [ Step 3: Judge Synthesis Verdict ] (Gemini 3.6 Flash)\n                     \342\224\202\n                     \342\226\274\n           [ Final Consensus Master Output ]`}\n            </div>\n          </div>\n\n          {/* Rate-Limit Strategy Breakdown */}\n          <div className=\"bg-indigo-950/20 border border-indigo-500/30 rounded-xl p-4\">\n            <h4 className=\"text-xs font-bold text-indigo-300 flex items-center gap-1.5 mb-2\">\n              <Zap className=\"w-4 h-4 text-amber-400\" />\n              <span>$0 Budget & Free Tier 