  file_change {
    absolute_path_uri: "file:///src/components/DebateArena.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { AgentDraft, AgentCritique, AgentId } from \'../types\';\nimport { AGENTS } from \'../data/agents\';\nimport { Bot, MessageSquare, Check, Copy, Clock, ShieldCheck, ChevronRight } from \'lucide-react\';\n\ninterface DebateArenaProps {\n  drafts: AgentDraft[];\n  critiques: AgentCritique[];\n}\n\nexport const DebateArena: React.FC<DebateArenaProps> = ({ drafts, critiques }) => {\n  const [selectedAgent, setSelectedAgent] = useState<AgentId | \'all\'>(\'all\');\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const handleCopy = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  const filteredDrafts =\n    selectedAgent === \'all\'\n      ? drafts\n      : drafts.filter((d) => d.agentId === selectedAgent);\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 lg:p-6 mb-8 shadow-xl\">\n      {/* Header & Agent Filter Tabs */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800\">\n        <div>\n          <h3 className=\"text-lg font-bold text-white flex items-center gap-2\">\n            <MessageSquare className=\"w-5 h-5 text-indigo-400\" />\n            <span>Debate Arena View</span>\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Compare initial stances and cross-critiques from each AI model\n          </p>\n        </div>\n\n        {/* Filter Agent Buttons */}\n        <div className=\"flex flex-wrap items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800\">\n          <button\n            type=\"button\"\n            onClick={() => setSelectedAgent(\'all\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n              selectedAgent === \'all\'\n                ? \'bg-indigo-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            All Models ({drafts.length})\n          </button>\n          {Object.values(AGENTS).map((agent) => (\n            <button\n              key={agent.id}\n              type=\"button\"\n              onClick={() => setSelectedAgent(agent.id as AgentId)}\n              className={`px-2.5 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all ${\n                selectedAgent === agent.id\n                  ? `${agent.bgColor} ${agent.textColor} ${agent.borderColor} border font-bold shadow-sm`\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <span>{agent.avatar}</span>\n              <span className=\"hidden md:inline\">{agent.badge}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Agent Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        {filteredDrafts.map((draft) => {\n          const agent = AGENTS[draft.agentId] || AGENTS[\'gpt4o\'];\n          const critique = critiques.find((c) => c.agentId === draft.agentId);\n\n          return (\n            <div\n              key={draft.agentId}\n              className={`bg-slate-950 rounded-xl p-4 sm:p-5 border ${agent.borderColor} transition-all hover:border-slate-700 flex flex-col justify-between`}\n            >\n              <div>\n                {/* Agent Header */}\n                <div className=\"flex items-center justify-between mb-3 pb-2.5 border-b border-slate-800/80\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <div className={`w-9 h-9 rounded-lg ${agent.bgColor} border ${agent.borderColor} flex items-center justify-center text-lg`}>\n                      {agent.avatar}\n                    </div>\n                    <div>\n                      <h4 className=\"text-sm font-bold text-white flex items-center gap-1.5\">\n                        {agent.name}\n                      </h4>\n                      <span className=\"text-[11px] text-slate-400\">{agent.provider}</span>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400 flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3 text-indigo-400\" />\n                      {(draft.executionTimeMs / 1000).toFixed(1)}s\n                    </span>\n\n                    <button\n                      onClick={() => handleCopy(draft.draftText, draft.agentId)}\n                      className=\"p-1.5 rounded bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white transition-colors\"\n                      title=\"Copy Draft\"\n                    >\n                      {copiedId === draft.agentId ? (\n                        <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                      ) : (\n                        <Copy className=\"w-3.5 h-3.5\" />\n                      )}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Initial Draft Stance */}\n                <div className=\"mb-4\">\n                  <span className=\"text-[11px] font-semibold tracking-wider text-slate-400 uppercase flex items-center gap-1 mb-1.5\">\n                    <ChevronRight className=\"w-3 h-3 text-indigo-400\" />\n                    Round 1: Initial Stance\n                  </span>\n                  <div className=\"bg-slate-900/60 p-3.5 rounded-lg border border-slate-800/60 text-xs sm:text-sm text-slate-200 leading-relaxed font-sans whitespace-pre-wrap\">\n                    {draft.draftText}\n                  </div>\n                </div>\n\n                {/* Round 2: Cross-Critique if available */}\n                {critique && (\n                  <div className=\"pt-2 border-t border-slate-800/80\">\n                    <span className=\"text-[11px] font-semibold tracking-wider text-amber-400 uppercase flex items-center gap-1 mb-1.5\">\n                      <ChevronRight className=\"w-3 h-3 text-amber-400\" />\n                      Round 2: Cross-Critique & Convergence\n                    </span>\n                    <div className=\"bg-amber-500/5 p-3.5 rounded-lg border border-amber-500/20 text-xs sm:text-sm text-amber-100/90 leading-relaxed font-sans whitespace-pre-wrap\">\n                      {critique.critiqueText}\n                    </div>\n\n                    {/* Agreed / Disagreed models */}\n                    {critique.agreedWithOthers && critique.agreedWithOthers.length > 0 && (\n                      <div className=\"mt-2.5 flex items-center gap-1.5 text-[11px] text-slate-400\">\n                        <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n                        <span>Aligned with:</span>\n                        <div className=\"flex flex-wrap gap-1\">\n                          {critique.agreedWithOthers.map((modelName, i) => (\n                            <span\n                              key={i}\n                              className=\"px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 font-medium\"\n                            >\n                              {modelName}\n                            </span>\n                          ))}\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
