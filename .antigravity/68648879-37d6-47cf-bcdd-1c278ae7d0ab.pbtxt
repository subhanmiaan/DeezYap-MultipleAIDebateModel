    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Cpu, Settings, FileCode, Trash2, History, Sparkles, ShieldCheck } from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenArchitecture: () => void;\n  onOpenApiKeys: () => void;\n  onToggleHistory: () => void;\n  onClearCache: () => void;\n  historyCount: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onOpenArchitecture,\n  onOpenApiKeys,\n  onToggleHistory,\n  onClearCache,\n  historyCount,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 text-slate-100 px-4 lg:px-8 py-3.5 shadow-lg\">\n      <div className=\"max-w-7xl mx-auto flex items-center justify-between gap-4\">\n        {/* Logo & Brand */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-600 via-indigo-600 to-purple-600 p-0.5 shadow-md shadow-indigo-500/20\">\n            <div className=\"w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center\">\n              <Cpu className=\"w-5 h-5 text-cyan-400\" />\n            </div>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"font-bold text-lg tracking-tight text-white flex items-center gap-2\">\n                AI Consensus Hub\n                <span className=\"text-xs px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-medium\">\n                  DebateAI v2.5\n                </span>\n              </h1>\n            </div>\n            <p className=\"text-xs text-slate-400 hidden sm:block\">\n              Multi-Agent LLM Debate, Cross-Critique & Synthesis Engine\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Free Tier Badge */}\n          <div className=\"hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-medium\">\n            <ShieldCheck className=\"w-3.5 h-3.5\" />\n            <span>100% Free Developer Tier</span>\n          </div>\n\n          {/* Architecture Blueprint Modal Trigger */}\n          <button\n            onClick={onOpenArchitecture}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition-colors border border-slate-700\"\n            title=\"View System Architecture Blueprint\"\n          >\n            <FileCode className=\"w-3.5 h-3.5 text-cyan-400\" />\n            <span className=\"hidden sm:inline\">Blueprint</span>\n          </button>\n\n          {/* Optional API Keys Modal */}\n          <button\n            onClick={onOpenApiKeys}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition-colors border border-slate-700\"\n            title=\"Configure API Keys\"\n          >\n            <Settings className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span className=\"hidden sm:inline\">API Keys</span>\n          </button>\n\n          {/* History Toggle */}\n          <button\n            onClick={onToggleHistory}\n            className=\"relative flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition-colors border border-slate-700\"\n            title=\"Debate History\"\n          >\n            <History className=\"w-3.5 h-3.5 text-purple-400\" />\n            <span className=\"hidden sm:inline\">History</span>\n            {historyCount > 0 && (\n              <span className=\"ml-1 px-1.5 py-0.2 bg-indigo-600 text-white rounded-full text-[10px] font-bold\">\n                {historyCount}\n              </span>\n            )}\n          </button>\n\n          {/* Clear Cache */}\n          <button\n            onClick={onClearCache}\n            className=\"p-1.5 rounded-lg bg-slate-800 hover:bg-red-500/20 text-slate-400 hover:text-red-400 transition-colors border border-slate-700\"\n            title=\"Clear Debate Cache\"\n          >\n            <Trash2 className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Zap, Settings, FileCode, Trash2, History, ShieldCheck } from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenArchitecture: () => void;\n  onOpenApiKeys: () => void;\n  onToggleHistory: () => void;\n  onClearCache: () => void;\n  historyCount: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onOpenArchitecture,\n  onOpenApiKeys,\n  onToggleHistory,\n  onClearCache,\n  historyCount,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-40 bg-black/90 backdrop-blur-md border-b border-zinc-800 text-zinc-100 px-4 lg:px-8 py-3.5 shadow-xl\">\n      <div className=\"max-w-7xl mx-auto flex items-center justify-between gap-4\">\n        {/* Logo & Brand */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-yellow-400 text-black flex items-center justify-center font-black text-xl shadow-lg shadow-yellow-400/20\">\n            <Zap className=\"w-6 h-6 fill-black text-black\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"font-black text-xl tracking-tight text-white flex items-center gap-2 uppercase\">\n                Deez<span className=\"text-yellow-400\">Yap</span>\n                <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 font-bold lowercase\">\n                  ai debate v2.5\n                </span>\n              </h1>\n            </div>\n            <p className=\"text-xs text-zinc-400 hidden sm:block font-medium\">\n              Multi-Agent AI Debate, Cross-Critique & Synthesis Engine\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Free Tier Badge */}\n          <div className=\"hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-yellow-400/10 border border-yellow-400/30 text-yellow-400 text-xs font-semibold\">\n            <ShieldCheck className=\"w-3.5 h-3.5\" />\n            <span>100% Free Dev Tier</span>\n          </div>\n\n          {/* Architecture Blueprint Modal Trigger */}\n          <button\n            onClick={onOpenArchitecture}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-200 text-xs font-semibold transition-colors border border-zinc-800 hover:border-yellow-400/50 cursor-pointer\"\n            title=\"View System Architecture Blueprint\"\n          >\n            <FileCode className=\"w-3.5 h-3.5 text-yellow-400\" />\n            <span className=\"hidden sm:inline\">Blueprint</span>\n          </button>\n\n          {/* Optional API Keys Modal */}\n          <button\n            onClick={onOpenApiKeys}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-200 text-xs font-semibold transition-colors border border-zinc-800 hover:border-yellow-400/50 cursor-pointer\"\n            title=\"Configure API Keys\"\n          >\n            <Settings className=\"w-3.5 h-3.5 text-yellow-400\" />\n            <span className=\"hidden sm:inline\">API Keys</span>\n          </button>\n\n          {/* History Toggle */}\n          <button\n            onClick={onToggleHistory}\n            className=\"relative flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-200 text-xs font-semibold transition-colors border border-zinc-800 hover:border-yellow-400/50 cursor-pointer\"\n            title=\"Debate History\"\n          >\n            <History className=\"w-3.5 h-3.5 text-yellow-400\" />\n            <span className=\"hidden sm:inline\">History</span>\n            {historyCount > 0 && (\n              <span className=\"ml-1 px-1.5 py-0.2 bg-yellow-400 text-black rounded-full text-[10px] font-black\">\n                {historyCount}\n              </span>\n            )}\n          </button>\n\n          {/* Clear Cache */}\n          <button\n            onClick={onClearCache}\n            className=\"p-1.5 rounded-lg bg-zinc-900 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 transition-colors border border-zinc-800 cursor-pointer\"\n            title=\"Clear Debate Cache\"\n          >\n            <Trash2 className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
