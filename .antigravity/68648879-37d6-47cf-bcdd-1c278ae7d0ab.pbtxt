    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Key, ShieldCheck, Save, Lock } from \'lucide-react\';\nimport { UserApiKeys } from \'../types\';\n\ninterface ApiKeysModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  userKeys: UserApiKeys;\n  onSaveKeys: (keys: UserApiKeys) => void;\n}\n\nexport const ApiKeysModal: React.FC<ApiKeysModalProps> = ({\n  isOpen,\n  onClose,\n  userKeys,\n  onSaveKeys,\n}) => {\n  const [groqKey, setGroqKey] = useState(userKeys.groqKey || \'\');\n  const [openRouterKey, setOpenRouterKey] = useState(userKeys.openRouterKey || \'\');\n  const [tavilyKey, setTavilyKey] = useState(userKeys.tavilyKey || \'\');\n  const [savedMsg, setSavedMsg] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSaveKeys({\n      groqKey: groqKey.trim(),\n      openRouterKey: openRouterKey.trim(),\n      tavilyKey: tavilyKey.trim(),\n    });\n    setSavedMsg(true);\n    setTimeout(() => {\n      setSavedMsg(false);\n      onClose();\n    }, 1200);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md\">\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative\">\n        <div className=\"flex items-center justify-between pb-4 border-b border-slate-800 mb-5\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-indigo-500/20 rounded-xl border border-indigo-500/30 text-indigo-400\">\n              <Key className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-base text-white\">Optional Custom API Keys</h3>\n              <p className=\"text-xs text-slate-400\">\n                Override or supplement free Gemini API calls with your own developer keys\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSave} className=\"space-y-4\">\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Groq Free Tier API Key (Optional for Llama 3.3 70B)\n            </label>\n            <input\n              type=\"password\"\n              value={groqKey}\n              onChange={(e) => setGroqKey(e.target.value)}\n              placeholder=\"gsk_...\"\n              className=\"w-full bg-slate-950 text-xs text-slate-100 placeholder-slate-600 rounded-lg p-2.5 border border-slate-800 focus:outline-none focus:border-indigo-500 font-mono\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              OpenRouter Free API Key (Optional)\n            </label>\n            <input\n              type=\"password\"\n              value={openRouterKey}\n              onChange={(e) => setOpenRouterKey(e.target.value)}\n              placeholder=\"sk-or-v1-...\"\n              className=\"w-full bg-slate-950 text-xs text-slate-100 placeholder-slate-600 rounded-lg p-2.5 border border-slate-800 focus:outline-none focus:border-indigo-500 font-mono\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Tavily Web Search API Key (Optional)\n            </label>\n            <input\n              type=\"password\"\n              value={tavilyKey}\n              onChange={(e) => setTavilyKey(e.target.value)}\n              placeholder=\"tvly-...\"\n              className=\"w-full bg-slate-950 text-xs text-slate-100 placeholder-slate-600 rounded-lg p-2.5 border border-slate-800 focus:outline-none focus:border-indigo-500 font-mono\"\n            />\n          </div>\n\n          <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800 text-[11px] text-slate-400 flex items-start gap-2\">\n            <Lock className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n            <span>\n              By default, AI Consensus Hub runs 100% out-of-the-box using the bundled Google AI Studio Free Tier Gemini API key. Keys entered here are stored locally in browser memory only.\n            </span>\n          </div>\n\n          <div className=\"pt-3 flex items-center justify-between border-t border-slate-800\">\n            {savedMsg ? (\n              <span className=\"text-xs text-emerald-400 font-medium flex items-center gap-1\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                Keys Saved!\n              </span>\n            ) : (\n              <span className=\"text-xs text-slate-500\">Local Client Storage</span>\n            )}\n\n            <button\n              type=\"submit\"\n              className=\"px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>Save Configuration</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
