    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  ConsensusResult,\n  ProgressState,\n  DebateMode,\n  DebateIntensity,\n  UserApiKeys,\n  AgentId,\n} from \'./types\';\nimport { Header } from \'./components/Header\';\nimport { PromptInput } from \'./components/PromptInput\';\nimport { ProgressStepper } from \'./components/ProgressStepper\';\nimport { ConsensusCard } from \'./components/ConsensusCard\';\nimport { AlignmentMatrix } from \'./components/AlignmentMatrix\';\nimport { DebateArena } from \'./components/DebateArena\';\nimport { ArchitectureModal } from \'./components/ArchitectureModal\';\nimport { ApiKeysModal } from \'./components/ApiKeysModal\';\nimport { HistorySidebar } from \'./components/HistorySidebar\';\nimport { AGENTS } from \'./data/agents\';\nimport { Sparkles, Cpu, ShieldCheck, HelpCircle, Layers, ArrowRight } from \'lucide-react\';\n\nexport default function App() {\n  const [currentResult, setCurrentResult] = useState<ConsensusResult | null>(null);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Modals & Sidebars State\n  const [isArchOpen, setIsArchOpen] = useState(false);\n  const [isKeysOpen, setIsKeysOpen] = useState(false);\n  const [isHistoryOpen, setIsHistoryOpen] = useState(false);\n\n  // User API Keys State\n  const [userKeys, setUserKeys] = useState<UserApiKeys>({});\n\n  // Debate History State stored in localStorage\n  const [history, setHistory] = useState<ConsensusResult[]>(() => {\n    try {\n      const saved = localStorage.getItem(\'ai_consensus_history\');\n      return saved ? JSON.parse(saved) : [];\n    } catch {\n      return [];\n    }\n  });\n\n  // Progress Stepper State\n  const [progress, setProgress] = useState<ProgressState>({\n    currentStep: 0,\n    statusText: \'\',\n    activeAgents: [],\n    logs: [],\n  });\n\n  useEffect(() => {\n    try {\n      localStorage.setItem(\'ai_consensus_history\', JSON.stringify(history));\n    } catch (e) {\n      console.error(\'Failed to save debate history to localStorage\', e);\n    }\n  }, [history]);\n\n  const handleStartDebate = async (\n    prompt: string,\n    mode: DebateMode,\n    intensity: DebateIntensity\n  ) => {\n    setIsLoading(true);\n    setError(null);\n\n    // Simulated progress steps for smooth UX feedback\n    setProgress({\n      currentStep: 1,\n      statusText: \'Phase 1: Dispatching parallel queries to 4 LLMs (ChatGPT, Claude, Llama, Perplexity)...\',\n      activeAgents: [\'gpt4o\', \'claude\', \'llama\', \'perplexity\'],\n      logs: [\'Dispatching parallel draft requests...\'],\n    });\n\n    const stepTimer1 = setTimeout(() => {\n      if (intensity === \'deep\') {\n        setProgress({\n          currentStep: 2,\n          statusText: \'Phase 2: Agents cross-critiquing arguments & identifying edge cases...\',\n          activeAgents: [\'gpt4o\', \'claude\', \'llama\', \'perplexity\'],\n          logs: [\'Drafts received. Generating cross-critiques...\'],\n        });\n      } else {\n        setProgress({\n          currentStep: 3,\n          statusText: \'Phase 3: Senior AI Judge synthesizing master consensus verdict...\',\n          activeAgents: [\'gpt4o\', \'claude\'],\n          logs: [\'Synthesizing consensus verdict...\'],\n        });\n      }\n    }, 2500);\n\n    const stepTimer2 = setTimeout(() => {\n      if (intensity === \'deep\') {\n        setProgress({\n          currentStep: 3,\n          statusText: \'Phase 3: Senior AI Judge synthesizing master consensus verdict...\',\n          activeAgents: [\'gpt4o\', \'claude\', \'llama\', \'perplexity\'],\n          logs: [\'Cross-critiques complete. Outputting structured consensus JSON...\'],\n        });\n      }\n    }, 5000);\n\n    try {\n      const response = await fetch(\'/api/debate\', {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n        },\n        body: JSON.stringify({\n          prompt,\n          mode,\n          intensity,\n          keys: userKeys,\n        }),\n      });\n\n      clearTimeout(stepTimer1);\n      clearTimeout(stepTimer2);\n\n      if (!response.ok) {\n        const errorData = await response.json();\n        throw new Error(errorData.error || \'Failed to complete multi-agent debate pipeline.\');\n      }\n\n      const data: ConsensusResult = await response.json();\n\n      setCurrentResult(data);\n      setHistory((prev) => [data, ...prev.filter((h) => h.id !== data.id)]);\n\n      setProgress({\n        currentStep: 0,\n        statusText: \'Consensus generated successfully!\',\n        activeAgents: [],\n        logs: [],\n      });\n    } catch (err: any) {\n      console.error(\'Error during debate pipeline:\', err);\n      setError(err?.message || \'An unexpected network error occurred.\');\n      setProgress({\n        currentStep: 0,\n        statusText: \'Pipeline error occurred.\',\n        activeAgents: [],\n        logs: [],\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleClearCache = async () => {\n    try {\n      await fetch(\'/api/cache/clear\', { method: \'POST\' });\n      alert(\'Debate cache cleared successfully!\');\n    } catch (err) {\n      console.error(\'Failed to clear cache:\', err);\n    }\n  };\n\n  const handleClearHistory = () => {\n    if (confirm(\'Are you sure you want to clear your saved debate history?\')) {\n      setHistory([]);\n      localStorage.removeItem(\'ai_consensus_history\');\n    }\n  };\n\n  const handleDeleteHistoryItem = (id: string) => {\n    setHistory((prev) => prev.filter((item) => item.id !== id));\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-indigo-500 selection:text-white pb-16\">\n      {/* Top Header */}\n      <Header\n        onOpenArchitecture={() => setIsArchOpen(true)}\n        onOpenApiKeys={() => setIsKeysOpen(true)}\n        onToggleHistory={() => setIsHistoryOpen(true)}\n        onClearCache={handleClearCache}\n        historyCount={history.length}\n      />\n\n      {/* Main Container */}\n      <main className=\"max-w-7xl mx-auto px-4 lg:px-8 pt-6\">\n        {/* Hero Section */}\n        <div className=\"text-center max-w-3xl mx-auto mb-8\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold mb-3\">\n            <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>Multi-Agent AI Debate & Synthesis Platform</span>\n          </div>\n          <h2 className=\"text-2xl sm:text-4xl font-extrabold tracking-tight text-white\">\n            One Prompt. Multiple AI Perspectives. <br className=\"hidden sm:inline\" />\n            <span className=\"bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-indigo-300 to-purple-400\">\n              One Ultimate Consensus Answer.\n            </span>\n          </h2>\n          <p className=\"text-xs sm:text-sm text-slate-400 mt-2.5 leading-relaxed\">\n            Submit any complex query to run structured multi-agent debates between{\' \'}\n            <span className=\"text-emerald-400 font-semibold\">ChatGPT (GPT-4o)</span>,{\' \'}\n            <span className=\"text-amber-400 font-semibold\">Claude 3.5 Sonnet</span>,{\' \'}\n            <span className=\"text-purple-400 font-semibold\">Groq Llama 3.3 70B</span>, and{\' \'}\n            <span className=\"text-cyan-400 font-semibold\">Perplexity Grounded Search</span>.\n          </p>\n        </div>\n\n        {/* Participating Agents Cards Row */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 mb-8\">\n          {Object.values(AGENTS).map((agent) => (\n            <div\n              key={agent.id}\n              className={`p-3 rounded-xl bg-slate-900/60 border ${agent.borderColor} flex items-center gap-3 shadow-md hover:bg-slate-900 transition-colors`}\n            >\n              <div className={`w-8 h-8 rounded-lg ${agent.bgColor} flex items-center justify-center text-base shrink-0`}>\n                {agent.avatar}\n              </div>\n              <div className=\"overflow-hidden\">\n                <h4 className=\"text-xs font-bold text-white truncate\">{agent.name}</h4>\n                <p className=\"text-[10px] text-slate-400 truncate\">{agent.description}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Prompt Input Component */}\n        <PromptInput onSubmit={handleStartDebate} isLoading={isLoading} />\n\n        {/* Error Notification */}\n        {error && (\n          <div className=\"bg-red-950/40 border border-red-500/50 text-red-200 p-4 rounded-xl text-xs sm:text-sm mb-8 flex items-center justify-between\">\n            <span>{error}</span>\n            <button\n              onClick={() => setError(null)}\n              className=\"text-xs underline font-semibold text-red-400 hover:text-red-300 ml-4 cursor-pointer\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n\n        {/* Real-Time Progress Stepper */}\n        {isLoading && <ProgressStepper progress={progress} />}\n\n        {/* Active Debate Output Display */}\n        {currentResult && !isLoading && (\n          <div>\n            {/* Master Consensus Card */}\n            <ConsensusCard consensus={currentResult} />\n\n            {/* Model Alignment Matrix */}\n            <AlignmentMatrix alignmentScores={currentResult.modelAgreementMatrix} />\n\n            {/* Debate Arena Detailed View */}\n            <DebateArena drafts={currentResult.drafts} critiques={currentResult.critiques} />\n          </div>\n        )}\n\n        {/* Empty State / Feature Explanation */}\n        {!currentResult && !isLoading && (\n          <div className=\"bg-slate-900/40 border border-slate-800 rounded-2xl p-8 text-center max-w-2xl mx-auto my-12\">\n            <div className=\"w-12 h-12 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 rounded-2xl flex items-center justify-center mx-auto mb-4\">\n              <Cpu className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"text-lg font-bold text-white mb-2\">Ready to Start a Debate</h3>\n            <p className=\"text-xs sm:text-sm text-slate-400 leading-relaxed mb-6\">\n              Enter a question above or choose a preset prompt to trigger parallel agent draft generation, cross-critiques, and verdict synthesis.\n            </p>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-left text-xs\">\n              <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n                <span className=\"font-bold text-indigo-400 block mb-1\">1. Parallel Drafts</span>\n                <span className=\"text-slate-400\">All 4 LLM agents draft independent answers simultaneously.</span>\n              </div>\n              <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n                <span className=\"font-bold text-amber-400 block mb-1\">2. Cross-Critique</span>\n                <span className=\"text-slate-400\">Agents point out logical flaws, missing assumptions, and edge cases.</span>\n              </div>\n              <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n                <span className=\"font-bold text-emerald-400 block mb-1\">3. Master Verdict</span>\n                <span className=\"text-slate-400\">A unified consensus is synthesized with confidence scoring.</span>\n              </div>\n            </div>\n          </div>\n        )}\n      </main>\n\n      {/* Modals & Sidebars */}\n      <ArchitectureModal isOpen={isArchOpen} onClose={() => setIsArchOpen(false)} />\n      <ApiKeysModal\n        isOpen={isKeysOpen}\n        onClose={() => setIsKeysOpen(false)}\n        userKeys={userKeys}\n        onSaveKeys={(keys) => setUserKeys(keys)}\n      />\n      <HistorySidebar\n        isOpen={isHistoryOpen}\n        onClose={() => setIsHistoryOpen(false)}\n        history={history}\n        onSelectDebate={(debate) => setCurrentResult(debate)}\n        onClearHistory={handleClearHistory}\n        onDeleteDebate={handleDeleteHistoryItem}\n      />\n    </div>\n  );\n}\n"
    }
