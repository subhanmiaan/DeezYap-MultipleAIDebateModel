# GEMINI_API_KEY: Required for Gemini AI API calls (100% Free Tier via Google AI Studio).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL FREE TIER KEYS (Can also be configured directly in the app UI):
# Without these, the Llama and DeepSeek agents still work but are simulated
# via Gemini personas rather than the real models.
# GROQ_API_KEY="gsk_..." # Real Groq Free Tier key for Llama 3.3 70B - get one free at console.groq.com
# DEEPSEEK_API_KEY="sk-..." # Real DeepSeek official API key - get one free (5M token trial, no card) at platform.deepseek.com
# OPENROUTER_API_KEY="sk-or-v1-..." # Optional OpenRouter Free Tier API Key (not yet wired into the pipeline)
# TAVILY_API_KEY="tvly-..." # Optional Tavily Web Search API Key (not yet wired into the pipeline)
